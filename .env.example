PORT=3000
NODE_ENV=development

# Utente admin creato automaticamente al primo avvio (seed).
# Dopo il primo login puoi creare altri operatori dalla pagina "Gestione utenti".
LOGIN_USER=admin
LOGIN_PASSWORD=changeme

# Deve essere una stringa lunga e casuale in produzione.
SESSION_SECRET=cambia-questo-valore

# Invio email via API HTTPS di Resend (resend.com) invece di SMTP diretto:
# molti host (Railway incluso, sui piani base) bloccano le porte SMTP in
# uscita, mentre l'HTTPS non è mai bloccato.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=alert@tuodominio.it
# Valore iniziale, usato solo al primo avvio per popolare il database.
# Dopo il primo avvio l'email destinatario si modifica dalla pagina Impostazioni (solo admin).
ALERT_EMAIL_TO=info@poshmap.com

# Segreto condiviso per chiamare POST /api/internal/check-alerts da un cron esterno
# (necessario su Railway, vedi README per i dettagli). Stringa lunga e casuale.
CRON_SECRET=cambia-questo-valore-lungo-e-casuale
